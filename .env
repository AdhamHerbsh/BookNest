# BookNest Database Configuration
# Copy this file and update with your actual database credentials

# Database Host
DB_HOST=localhost

# Database Name
DB_NAME=booknest

# Database User
DB_USER=booknest_user

# Database Password
DB_PASS=secure_password_here

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Security Settings
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Rate Limiting
LOGIN_ATTEMPTS=5
LOGIN_WINDOW=900

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/